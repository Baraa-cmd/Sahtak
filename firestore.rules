rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Pharmacies collection: readable by all users (list & get)
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow write: if isValidId(pharmacyId);
    }

    // Nurses collection: readable by all users (list & get)
    match /nurses/{nurseId} {
      allow read: if true;
      allow write: if isValidId(nurseId);
    }

    // Hospitals collection: readable by all users (list & get)
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isValidId(hospitalId);
    }

    // App users collection (accounts for admin and providers)
    match /app_users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
